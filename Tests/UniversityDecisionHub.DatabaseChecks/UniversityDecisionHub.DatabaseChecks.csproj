<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The checks run against an in-memory SQLite database created from the EF model. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Backend/UniversityDecisionHub.Api/UniversityDecisionHub.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The report queries are executed as part of the checks. -->
    <None Include="../../Doc/sql/report_queries.sql" Link="report_queries.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
